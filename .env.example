# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# A Finder-launched .app inherits no shell environment, so exporting this in
# .zshrc will NOT reach the app. This file does.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5 (cheap; ample for a two-sentence read).
# GOLFSWING_MODEL=claude-opus-5
